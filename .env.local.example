# Supabase — sauvegarde cloud & cave entre amis (optionnel).
# Sans ces variables, Œno fonctionne en mode 100 % local (localStorage).
# À renseigner aussi dans Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Intelligence artificielle — scan d'étiquette, enrichissement web,
# assistant, actualité du vin. Au moins UNE des trois clés suffit.
# L'app tente Anthropic d'abord, puis Groq, puis Gemini en dernier repli.
# Sans aucune clé, ces fonctions affichent un message d'indisponibilité
# élégant et le reste de l'app fonctionne normalement.
# Clé Anthropic (prioritaire) : console.anthropic.com
ANTHROPIC_API_KEY=
# Clé Groq (2e repli, rapide, palier gratuit généreux) : console.groq.com
GROQ_API_KEY=
# Clé Google Gemini (dernier repli) : aistudio.google.com
GEMINI_API_KEY=
# Clé Tavily (recherche web en direct pour Groq, qui n'a pas d'outil de
# recherche natif comme Claude/Gemini) : app.tavily.com
TAVILY_API_KEY=
