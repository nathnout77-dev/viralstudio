# Supabase — sauvegarde cloud & cave entre amis (optionnel).
# Sans ces variables, Œno fonctionne en mode 100 % local (localStorage).
# À renseigner aussi dans Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Intelligence artificielle — scan d'étiquette, enrichissement web,
# assistant, actualité du vin. Au moins UNE des deux clés suffit.
# L'app tente Anthropic d'abord, puis bascule sur Gemini en repli.
# Sans aucune clé, ces fonctions affichent un message d'indisponibilité
# élégant et le reste de l'app fonctionne normalement.
# Clé Anthropic (prioritaire) : console.anthropic.com
ANTHROPIC_API_KEY=
# Clé Google Gemini (repli, palier gratuit) : aistudio.google.com
GEMINI_API_KEY=
