{
  "expo": {
    "name": "Œno",
    "slug": "oeno",
    "scheme": "oeno",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0A09",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Œno utilise la caméra pour scanner vos étiquettes de vin."
      }
    },
    "android": {
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        { "cameraPermission": "Œno utilise la caméra pour scanner vos étiquettes de vin." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
