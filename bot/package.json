{
  "name": "job-bot",
  "version": "1.0.0",
  "description": "Bot de candidature automatique - Commercial automobile/industrie/vente",
  "scripts": {
    "start": "tsx src/index.ts",
    "search": "tsx src/index.ts --search-only",
    "apply": "tsx src/index.ts --apply-only",
    "dry-run": "tsx src/index.ts --search-only --dry-run",
    "search:ft": "tsx src/search-ft.ts",
    "report": "tsx src/report.ts",
    "install-browser": "npx playwright install chromium --with-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
